# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRO_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-pro-exp-02-05

# Database (defaults to local sqlite for dev, postgresql for production)
DATABASE_URL=sqlite:///./ramad_mador.db
# For PostgreSQL on Railway: postgresql+psycopg2://user:pass@host:5432/dbname

# Meta for Developers (WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=ramad_verify_token_secret
RAMAD_PHONE_NUMBER=972500000000

# Server
PORT=8000
HOST=0.0.0.0
